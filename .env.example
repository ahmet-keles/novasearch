# Copy to .env and adjust as needed. All settings use the NOVA_ prefix.
# Defaults match the ports published by compose.yaml.
NOVA_DATABASE_URL=postgresql+psycopg://nova:nova@localhost:5442/novasearch
NOVA_REDIS_URL=redis://localhost:6389/0

# Embedding provider: "hashing" (deterministic lexical baseline, default) or
# "model" (all-MiniLM-L6-v2 via ONNX; needs `pip install -e ".[model]"` and a
# one-time model download).
NOVA_EMBEDDING_PROVIDER=hashing
NOVA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NOVA_EMBEDDING_BATCH_SIZE=32
